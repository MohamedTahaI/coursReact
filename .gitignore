# Dependencies — never committed.
# This repo holds ~20 separate course projects, each with its own node_modules. Committing
# even one of them adds tens of thousands of files and hundreds of megabytes that git can
# never really forget, and every one of them is reproducible from package-lock.json.
node_modules/

# Build output — generated from the source that IS committed.
build/
dist/
.next/
out/
.parcel-cache/
.vite/

# Secrets. .env.example (if a project has one) is deliberately not ignored.
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
*.swp

# Test + tooling caches
coverage/
.eslintcache
